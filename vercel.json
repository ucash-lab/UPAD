{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/launchpad.js": {
      "maxDuration": 240
    }
  },
  "rewrites": [
    {
      "source": "/api/launchpad/:route*",
      "destination": "/api/launchpad?ucashRoute=:route*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}